# ---- Frontend build (Vite → static dist) ----
FROM node:22-bookworm-slim AS web-build
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_API_URL=https://batch.bodylia.in
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ---- Go API build (Ubuntu 24.04 dry-run parity; go1.26 bookworm) ----
FROM golang:1.26-bookworm AS api-build
WORKDIR /api
COPY backend-go/go.mod backend-go/go.sum ./
RUN go mod download
COPY backend-go/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/batch-api .

# ---- Web runtime: nginx serves SPA (+ /health) ----
FROM nginx:stable-alpine AS web-runtime
COPY deploy/nginx-batch-bodylia.conf /etc/nginx/conf.d/batch-bodylia.conf
COPY --from=web-build /web/dist/ /usr/share/nginx/html/
EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]

# ---- API runtime: minimal Ubuntu 24.04 (dry-run prod parity) ----
FROM ubuntu:24.04 AS api-runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata \
  && rm -rf /var/lib/apt/lists
RUN useradd -r -u 10001 -m -s /usr/sbin/nologin app
COPY --from=api-build /out/batch-api /usr/local/bin/batch-api
COPY backend-go/migrations/ /migrations/
USER app
EXPOSE 8101
ENV PORT=8101 GIN_MODE=release
CMD ["/usr/local/bin/batch-api"]
