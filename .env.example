# batch.bodylia.in — frontend env template (copy to .env.development / .env.test / .env.production)
# RULE: no dataset, credential, or secret in source. Everything env-driven.

# Go service base URL. Empty = legacy in-memory mock (dev preview only, NEVER production).
VITE_API_URL=http://127.0.0.1:8101

# Set 1 to allow the in-memory mock store in development. Ignored in production builds.
VITE_MOCK_DATA=0

# Preview console credentials (dev/test ONLY — resolved via previewEnv in lib/auth.ts).
VITE_PREVIEW_PASSWORD=
VITE_PREVIEW_TOTP=
VITE_PREVIEW_RECOVERY=
