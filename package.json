{
  "name": "batch-bodylia-in",
  "private": true,
  "version": "1.0.0",
  "description": "Bodylia batch verification portal — batch.bodylia.in (public verify + staff console)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "VITE_API_URL=http://127.0.0.1:8101 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host batch.bodylia.in --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "sh -c 'cd backend-go && DB_NAME=${DB_NAME:-bodyliabatch_test} JWT_SECRET=${JWT_SECRET:-test-secret} go test ./... -v'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "services:up": "sh scripts/services-up.sh",
    "db:migrate": "sh scripts/db-migrate.sh",
    "db:seed": "sh scripts/db-migrate.sh",
    "db:reset": "sh scripts/db-reset.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-checkbox": "1.1.2",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "11.18.2",
    "html2pdf.js": "0.10.2",
    "jspdf": "2.5.2",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "react-markdown": "9.0.1",
    "react-router-dom": "6.30.2",
    "remark-gfm": "4.0.0",
    "tailwind-merge": "2.6.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^2.1.8",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "2.1.8"
  }
}
