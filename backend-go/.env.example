# Local env for batch.bodylia.in Go service (copy to .env — never commit secrets)
APP_ENV=development
PORT=8101
DB_HOST=localhost
DB_PORT=5432
DB_USER=roshanshah
DB_NAME=bodyliabatch
# DB_PASSWORD=  (Postgres.app trusts local user; set in staging/prod)
JWT_SECRET=dev-secret-change-me
# EMAILIT_API_KEY — EmailIt v2 API key (post https://api.emailit.com/v2/emails).
# Required in production; unset locally degrades to an ops log of the 2FA code.
# EMAILIT_API_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:5175,http://127.0.0.1:5173,https://batch.bodylia.in
GIN_MODE=release
